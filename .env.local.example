# Copy to .env.local and fill in. All values are optional in Phase 1.

# PostHog analytics (visits, saves, outbound clicks). Without a key, analytics
# calls are safe no-ops. Get a key at https://posthog.com (free tier).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical site URL — set to your Vercel URL after the first deploy so shared
# links render the correct Open Graph preview card.
NEXT_PUBLIC_SITE_URL=
